* text=auto eol=lf

*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.toml text eol=lf

# Keep the reviewed browser exports byte-identical to their recorded hashes.
examples/workflows/92-open-regenerate/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
examples/workflows/93-director-reviewed/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve pinned third-party source bytes; audit hashes cover this exact vendored tree.
h3_t8/vendor/vretoucher_upstream/** -whitespace

# Keep all eight accepted Pika two-stage browser exports byte-identical.
examples/workflows/95-pika-dual/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Keep candidate UI exports exact for the next human-review/source binding.
examples/workflows/96-nov05-exp/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve reviewed UI/API recipes; only release NOTE/title text was updated.
